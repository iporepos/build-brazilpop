  "output_dir": null,
  "version": "6",
  "kinds": ["scatter", "hexbin", "histogram"],
  "scales": ["tract", "district", "municipality"],
  "mode": "light",
  "dpi": 150,
  "format": "jpeg",
  "style": {},
  "accent": "brazilpop",
  "cmap": "plasma_r",
  "cmap_min": 0.0,
  "cmap_max": 1.0,
  "products": {
    "brazilpop": {"label": "BrazilPop V{version} {year}"},
    "landscan": {"label": "LandScan {year}", "min_scale": "municipality"},
    "worldpop": {"label": "WorldPop {year}", "min_scale": "municipality"},
    "ghsl": {"label": "GHSL 2020", "min_scale": "municipality"},
    "hrsl": {"label": "HRSL V1 2018", "min_scale": "municipality"}
  }
}
